{
  "name": "@pi-cmux/agentd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The execution supervisor daemon.",
  "bin": {
    "agentd": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --test --test-reporter=spec --test-timeout=60000 --enable-source-maps \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@pi-cmux/adapter-fake": "workspace:*",
    "@pi-cmux/core": "workspace:*",
    "@pi-cmux/observability": "workspace:*",
    "@pi-cmux/policy": "workspace:*",
    "@pi-cmux/process-supervisor": "workspace:*",
    "@pi-cmux/protocol": "workspace:*",
    "@pi-cmux/sandbox": "workspace:*",
    "@pi-cmux/testkit": "workspace:*",
    "@pi-cmux/worktrees": "workspace:*",
    "zod": "4.4.3"
  }
}
