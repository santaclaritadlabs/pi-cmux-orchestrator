# Supply-chain controls. See docs/threat-model.md and CLAUDE.md ("Security and
# supply-chain rules"). Every setting here is load-bearing; do not relax one
# without an ADR.

# Never run dependency lifecycle scripts. A compromised transitive package must
# not get code execution merely because we installed it.
ignore-scripts=true

# No floating ranges. Every dependency is pinned to an exact version and the
# lockfile is authoritative.
save-exact=true

# Refuse to install under an unsupported Node.
engine-strict=true

# Peers must be declared explicitly; do not silently invent a resolution.
auto-install-peers=false
strict-peer-dependencies=true

# Cooldown: refuse versions published less than 24h ago. A hijacked package is
# usually yanked within hours, and nothing here needs same-day upgrades.
minimum-release-age=1440
