{
  "name": "@pi-cmux/agentd",
  "version": "0.0.0",
  "type": "module",
  "description": "The execution supervisor daemon.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bundle"
  ],
  "bin": {
    "agentd": "./bundle/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --test --test-reporter=spec --test-timeout=90000 --enable-source-maps \"dist/**/*.test.js\"",
    "bundle": "node scripts/bundle.mjs",
    "verify": "node bundle/cli.js verify"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@pi-cmux/adapter-antigravity": "workspace:*",
    "@pi-cmux/adapter-claude": "workspace:*",
    "@pi-cmux/adapter-codex": "workspace:*",
    "@pi-cmux/adapter-cursor": "workspace:*",
    "@pi-cmux/adapter-fake": "workspace:*",
    "@pi-cmux/core": "workspace:*",
    "@pi-cmux/observability": "workspace:*",
    "@pi-cmux/policy": "workspace:*",
    "@pi-cmux/process-supervisor": "workspace:*",
    "@pi-cmux/protocol": "workspace:*",
    "@pi-cmux/sandbox": "workspace:*",
    "@pi-cmux/testkit": "workspace:*",
    "@pi-cmux/worktrees": "workspace:*",
    "zod": "4.4.3"
  }
}
