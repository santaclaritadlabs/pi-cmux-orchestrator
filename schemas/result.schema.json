{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResult",
  "description": "Serialized shape of AgentResult (protocol version 1). Structural only: cross-field invariants are enforced by the zod schemas in @pi-cmux/protocol and are NOT expressible here. Do not use this file as the sole validation of untrusted input.",
  "readOnly": true,
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "1"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4096
    },
    "exitCode": {
      "type": "integer",
      "minimum": -256,
      "maximum": 256
    },
    "findings": {
      "readOnly": true,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\0]*$"
          },
          "detail": {
            "type": "string",
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\0]*$"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "severity",
          "title",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "tests": {
      "readOnly": true,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\0]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "changedFiles": {
      "readOnly": true,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\0]*$"
      }
    },
    "artifacts": {
      "readOnly": true,
      "maxItems": 512,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\0]*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\0]*$"
          }
        },
        "required": [
          "name",
          "digest",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "worktreePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\0]*$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "worktreePath",
        "dirty"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "readOnly": true,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "failure": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PROTOCOL_VERSION_UNSUPPORTED",
            "SCHEMA_INVALID",
            "UNKNOWN_EVENT_TYPE",
            "DUPLICATE_TERMINAL_RESULT",
            "SEQUENCE_CONFLICT",
            "POLICY_DENIED",
            "PATH_ESCAPE",
            "CAPABILITY_UNSUPPORTED",
            "SANDBOX_UNAVAILABLE",
            "NETWORK_DENIED",
            "REPO_UNSAFE",
            "WORKTREE_CONFLICT",
            "WORKTREE_OWNERSHIP_UNPROVEN",
            "GIT_COMMAND_FAILED",
            "INVALID_STATE_TRANSITION",
            "RUN_NOT_FOUND",
            "TASK_NOT_FOUND",
            "RUN_ALREADY_EXISTS",
            "RUN_LOCKED",
            "ORPHANED_RUN",
            "WORKER_SPAWN_FAILED",
            "WORKER_EXITED_NONZERO",
            "TIMEOUT_SOFT",
            "TIMEOUT_HARD",
            "CANCELLED",
            "OUTPUT_LIMIT_EXCEEDED",
            "MALFORMED_WORKER_OUTPUT",
            "MISSING_TERMINAL_EVENT",
            "STORE_IO_FAILED",
            "STORE_CORRUPT",
            "RPC_UNAUTHENTICATED",
            "RPC_METHOD_UNKNOWN",
            "RPC_MESSAGE_TOO_LARGE",
            "RPC_MALFORMED",
            "INTERNAL"
          ]
        },
        "safeMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\0]*$"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "safeMessage",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "taskId",
    "runId",
    "status",
    "summary",
    "findings",
    "tests",
    "changedFiles",
    "artifacts",
    "changes",
    "warnings"
  ],
  "additionalProperties": false
}
