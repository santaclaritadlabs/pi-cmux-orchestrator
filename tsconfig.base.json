{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // Source writes `./foo.ts`; tsc rewrites it to `./foo.js` on emit. Keeps
    // the specifier honest about the file that actually exists on disk and
    // leaves the door open to running sources directly under Node's type
    // stripping without a second module-resolution story.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
